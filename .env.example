
# Optional: basemap tile endpoint. Defaults to OpenStreetMap's standard tiles,
# which are free to use with attribution and need no key. OSM asks heavy
# consumers to move to their own provider; point this at any {z}/{x}/{y}
# endpoint to do that. See https://operations.osmfoundation.org/policies/tiles/
NEXT_PUBLIC_TILE_URL=

# Where Next serves the app from. Leave EMPTY for local development so the app
# runs at http://localhost:3000. Production is served through a rewrite at
# ipstack.com/devtools/what-is-my-ip and must set this to that sub-path.
NEXT_PUBLIC_BASE_PATH=

# Optional: serve public/ files (images, icons) from an absolute URL such as a
# CDN, instead of a basePath-relative path. Leave unset for default behavior.
NEXT_PUBLIC_ASSET_BASE_URL=

# The page's public address, used for canonical, Open Graph, sitemap and
# structured data. Defaults to https://ipstack.com + /devtools/what-is-my-ip.
# These are deliberately separate from NEXT_PUBLIC_BASE_PATH: the canonical URL
# must describe production even when you are running locally.
NEXT_PUBLIC_SITE_ORIGIN=
NEXT_PUBLIC_SITE_PATH=

# Optional: v4-only and v6-only endpoints used to detect both of your addresses.
# Defaults to ident.me, which is CORS-enabled. Point these at your own A-only
# and AAAA-only subdomains to keep the lookup in-house.
NEXT_PUBLIC_IPV4_PROBE=
NEXT_PUBLIC_IPV6_PROBE=
